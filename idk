local fpsStabilityBuffer = {}

local function calculateHighestStableCap()
	local rawTarget = deviceMaxFPS * 0.92
	if #fpsStabilityBuffer >= 3 then
		local sum = 0
		local minFps = 999
		local maxFps = 0
		for _, v in ipairs(fpsStabilityBuffer) do
			sum = sum + v
			if v < minFps then minFps = v end
			if v > maxFps then maxFps = v end
		end
		local avg = sum / #fpsStabilityBuffer
		local variance = maxFps - minFps
		if variance > 15 then
			rawTarget = math.min(rawTarget, avg * 0.90)
		else
			rawTarget = math.max(rawTarget, avg * 0.95)
		end
	end

	local steps = {240, 180, 165, 144, 120, 100, 90, 75, 60, 50, 45, 40, 30, 25}
	for _, s in ipairs(steps) do
		if rawTarget >= (s - 3) then
			return s
		end
	end
	return math.clamp(math.round(rawTarget), 25, 240)
end

local function getSmartAfkCap()
	local idleTime = os.clock() - lastActivityTime
	local baseCap = math.clamp(math.round(deviceMaxFPS * 0.5), 20, 30)
	if afkLevel == 1 then
		return (idleTime < 10) and baseCap or 20
	elseif afkLevel == 2 then
		return (idleTime < 10) and math.min(baseCap, 25) or 12
	else
		if idleTime < 5 then
			return 20
		elseif idleTime < 60 then
			return 10
		else
			return 5
		end
	end
end

local function syncFpsCap(force)
	local targetCap = 0
	if boostOn and afkEnabled then
		targetCap = getSmartAfkCap()
	elseif smartFpsCapEnabled then
		computedSmartCap = calculateHighestStableCap()
		targetCap = computedSmartCap
	elseif fpsCapEnabled then
		targetCap = currentFpsCap
	else
		targetCap = 0
	end

	activeTargetCap = targetCap

	if force or lastAppliedCap ~= targetCap then
		lastAppliedCap = targetCap
		if setfpscap and type(setfpscap) == "function" then
			pcall(function()
				setfpscap(targetCap > 0 and targetCap or 9999)
			end)
		end
	end
end
