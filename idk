local MIN_FPS_CAP = 15
local MAX_FPS_CAP = 240

local function getFpsRecommendColor(val)
	local sweetSpotMax = math.max(30, math.round(deviceMaxFPS * 0.92))
	local stretchMax = math.max(45, math.round(deviceMaxFPS * 1.15))

	if val >= 25 and val <= sweetSpotMax then
		return Color3.fromRGB(70, 255, 70)
	elseif (val >= 18 and val < 25) or (val > sweetSpotMax and val <= stretchMax) then
		return Color3.fromRGB(255, 220, 50)
	else
		return Color3.fromRGB(255, 70, 70)
	end
end

local function updateFpsCapSliderVisual(val)
	local clamped = math.clamp(math.round(val), MIN_FPS_CAP, MAX_FPS_CAP)
	local ratio = (clamped - MIN_FPS_CAP) / (MAX_FPS_CAP - MIN_FPS_CAP)
	local recColor = getFpsRecommendColor(clamped)

	fpsCapValueLabel.Text = tostring(clamped) .. " FPS Cap"
	fpsCapValueLabel.TextColor3 = recColor
	fpsCapKnob.BackgroundColor3 = recColor
	fpsCapKnob.Position = UDim2.new(ratio, 8 - (ratio * 16), 0.5, 0)
end
updateFpsCapSliderVisual(currentFpsCap)

