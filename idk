		end
	end
	if customPos then
		sliderKnob.Position = customPos
	elseif animEnabled then
		TweenService:Create(sliderKnob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = dotsPositions[targetLvl]}):Play()
	else
		sliderKnob.Position = dotsPositions[targetLvl]
	end
end
