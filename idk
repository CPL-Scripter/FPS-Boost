local function getCurrentPingMs()
	local pingMs = 0
	local ok, val = pcall(function()
		return math.round(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
	end)
	if ok and type(val) == "number" and val > 0 then
		pingMs = val
	else
		pcall(function()
			pingMs = math.round(LocalPlayer:GetNetworkPing() * 1000)
		end)
	end
	return math.max(0, pingMs)
end

