local boostToken = 0

local workspace_svc = cloneref(game:GetService("Workspace"))
local lighting_svc = cloneref(game:GetService("Lighting"))
local terrain = workspace_svc.Terrain

local originalSettings = {}
local originalLighting = {}
local originalExtraSettings = {}
local savedQualityLevel = nil
local ultraConnection = nil

local modeLevels = {Low = 1, Medium = 2, High = 3, Ultra = 4}

local function saveProp(inst, prop)
	if not originalSettings[inst] then
		originalSettings[inst] = {}
	end
	if originalSettings[inst][prop] == nil then
		originalSettings[inst][prop] = inst[prop]
	end
end

local function optimizeInstance(v, level, mult)
	if level >= 1 then
		if v:IsA("Explosion") then
			saveProp(v, "Visible")
			v.Visible = false
		elseif v:IsA("SurfaceGui") or v:IsA("BillboardGui") then
			saveProp(v, "Enabled")
			v.Enabled = false
		end
	end

	if level >= 2 then
		if v:IsA("Beam") or v:IsA("Highlight") then
			saveProp(v, "Enabled")
			v.Enabled = false
		elseif v:IsA("Shirt") then
			saveProp(v, "ShirtTemplate")
			v.ShirtTemplate = ""
		elseif v:IsA("Pants") then
			saveProp(v, "PantsTemplate")
			v.PantsTemplate = ""
		elseif v:IsA("ShirtGraphic") then
			saveProp(v, "Graphic")
			v.Graphic = ""
		end
	end

	if level >= 3 then
		if v:IsA("SpecialMesh") then
			saveProp(v, "TextureId")
			v.TextureId = ""
		end
	end

	if level >= 4 then
		if v:IsA("Accessory") or v:IsA("Hat") then
			local handle = v:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				saveProp(handle, "Transparency")
				handle.Transparency = 1
			end
		elseif v:IsA("BasePart") then
			saveProp(v, "Material")
			saveProp(v, "Reflectance")
			saveProp(v, "CastShadow")
			saveProp(v, "LocalTransparencyModifier")
			if v:IsA("MeshPart") then
				saveProp(v, "TextureID")
				v.TextureID = ""
			end
			v.Material = Enum.Material.SmoothPlastic
			v.Reflectance = 0
			v.CastShadow = false
		elseif v:IsA("Decal") or v:IsA("Texture") then
			saveProp(v, "Transparency")
			v.Transparency = 1
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
			saveProp(v, "Enabled")
			v.Enabled = false
		end
	end

	if mult >= 3 then
		if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
			saveProp(v, "Range")
			saveProp(v, "Brightness")
			saveProp(v, "Enabled")
			saveProp(v, "Shadows")
			v.Range = originalSettings[v].Range / mult
			v.Brightness = originalSettings[v].Brightness / mult
			v.Shadows = false
			if mult >= 10 then v.Enabled = false end
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
			saveProp(v, "Enabled")
			if v:IsA("ParticleEmitter") then
				saveProp(v, "Rate")
				v.Rate = originalSettings[v].Rate / mult
			end
			if mult >= 6 then v.Enabled = false end
		elseif v:IsA("Decal") or v:IsA("Texture") then
			saveProp(v, "Transparency")
			if mult >= 6 or level >= 4 then
				v.Transparency = 1
			else
				v.Transparency = math.clamp(1 - (1 / mult), originalSettings[v].Transparency, 1)
			end
		elseif v:IsA("BasePart") then
			saveProp(v, "Material")
			saveProp(v, "Reflectance")
			saveProp(v, "CastShadow")
			saveProp(v, "LocalTransparencyModifier")
			v.CastShadow = false
			if level < 4 then
				v.Reflectance = originalSettings[v].Reflectance / mult
			end
			if mult >= 6 and not (LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character)) then
				v.LocalTransparencyModifier = (mult >= 10) and 1 or 0.75
			elseif mult < 6 then
				v.LocalTransparencyModifier = originalSettings[v].LocalTransparencyModifier
			end
		end
	end
end

local function restoreOriginalState(myToken)
	syncFpsCap(true)
	blackScreen.Visible = false

	if ultraConnection then
		ultraConnection:Disconnect()
		ultraConnection = nil
	end

	pcall(function() 
		if savedQualityLevel then
			settings().Rendering.QualityLevel = savedQualityLevel
			savedQualityLevel = nil
		else
			settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
		end
	end)
	pcall(function()
		if originalLighting.GlobalShadows ~= nil then
			lighting_svc.GlobalShadows = originalLighting.GlobalShadows
			terrain.WaterWaveSize = originalLighting.WaterWaveSize
			terrain.WaterWaveSpeed = originalLighting.WaterWaveSpeed
		end
		if originalLighting.WaterReflectance ~= nil then
			terrain.WaterReflectance = originalLighting.WaterReflectance
			terrain.WaterTransparency = originalLighting.WaterTransparency
		end
	end)

	if originalExtraSettings.SoundVolume ~= nil then 
		pcall(function() SoundService.Volume = originalExtraSettings.SoundVolume end)
	end
	if originalExtraSettings.LightingTech ~= nil then 
		pcall(function() lighting_svc.Technology = originalExtraSettings.LightingTech end)
	end
	if originalExtraSettings.EnvDiffuse ~= nil then
		pcall(function()
			lighting_svc.EnvironmentDiffuseScale = originalExtraSettings.EnvDiffuse
			lighting_svc.EnvironmentSpecularScale = originalExtraSettings.EnvSpecular
		end)
	end
	if originalExtraSettings.FogEnd ~= nil then
		pcall(function()
			lighting_svc.FogEnd = originalExtraSettings.FogEnd
			lighting_svc.FogStart = originalExtraSettings.FogStart
			if originalExtraSettings.Brightness ~= nil then
				lighting_svc.Brightness = originalExtraSettings.Brightness
			end
		end)
	end

	local count = 0
	for obj, props in pairs(originalSettings) do
		if myToken and boostToken ~= myToken then return end
		count = count + 1
		if obj then 
			for propName, propValue in pairs(props) do
				pcall(function() obj[propName] = propValue end)
			end
		end
		if count % 5000 == 0 then
			task.wait()
		end
	end
	table.clear(originalSettings)
	table.clear(originalExtraSettings)
	table.clear(originalLighting)
end

local function applyBoost(state, mode)
	boostToken = boostToken + 1
	local myToken = boostToken
	local level = modeLevels[mode] or 1
	local mult = afkEnabled and (afkMultipliers[afkLevel] or 3) or 1
	
	if state then
		restoreOriginalState(myToken)
		if boostToken ~= myToken then return end

		syncFpsCap(true)

		if mult >= 10 then
			registerUserActivity()
			blackScreen.Visible = true
		else
			blackScreen.Visible = false
		end

		if level >= 1 or mult >= 3 then
			pcall(function()
				if originalExtraSettings.SoundVolume == nil then
					originalExtraSettings.SoundVolume = SoundService.Volume
				end
				SoundService.Volume = 0
			end)
			pcall(function()
				for _, v in pairs(lighting_svc:GetChildren()) do
					if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
						saveProp(v, "Enabled")
						v.Enabled = false
					end
				end
			end)
		end

		if level >= 2 or mult >= 3 then
			pcall(function()
				if originalExtraSettings.LightingTech == nil then
					originalExtraSettings.LightingTech = lighting_svc.Technology
					originalExtraSettings.FogEnd = lighting_svc.FogEnd
					originalExtraSettings.FogStart = lighting_svc.FogStart
					originalExtraSettings.Brightness = lighting_svc.Brightness
					originalExtraSettings.EnvDiffuse = lighting_svc.EnvironmentDiffuseScale
					originalExtraSettings.EnvSpecular = lighting_svc.EnvironmentSpecularScale
				end
				lighting_svc.Technology = Enum.Technology.Compatibility
				local baseFog = (level >= 2) and 250 or math.min(originalExtraSettings.FogEnd, 500)
				lighting_svc.FogEnd = baseFog / mult
				lighting_svc.FogStart = 0
				if mult >= 3 then
					lighting_svc.Brightness = originalExtraSettings.Brightness / mult
					lighting_svc.EnvironmentDiffuseScale = originalExtraSettings.EnvDiffuse / mult
					lighting_svc.EnvironmentSpecularScale = originalExtraSettings.EnvSpecular / mult
				end
			end)
		end

		if level >= 3 or mult >= 3 then
			pcall(function()
				if originalLighting.GlobalShadows == nil then
					originalLighting.GlobalShadows = lighting_svc.GlobalShadows
					originalLighting.WaterWaveSize = terrain.WaterWaveSize
					originalLighting.WaterWaveSpeed = terrain.WaterWaveSpeed
				end
				lighting_svc.GlobalShadows = false
				terrain.WaterWaveSize = (level >= 3) and 0 or (originalLighting.WaterWaveSize / mult)
				terrain.WaterWaveSpeed = (level >= 3) and 0 or (originalLighting.WaterWaveSpeed / mult)
				
				if level >= 3 or mult >= 6 then
					if originalExtraSettings.EnvDiffuse == nil then
						originalExtraSettings.EnvDiffuse = lighting_svc.EnvironmentDiffuseScale
						originalExtraSettings.EnvSpecular = lighting_svc.EnvironmentSpecularScale
					end
					lighting_svc.EnvironmentDiffuseScale = 0
					lighting_svc.EnvironmentSpecularScale = 0
				end
			end)
			pcall(function() 
				if savedQualityLevel == nil then
					savedQualityLevel = settings().Rendering.QualityLevel
				end
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 
			end)
		end

		if level >= 4 or mult >= 6 then
			pcall(function()
				if originalLighting.WaterReflectance == nil then
					originalLighting.WaterReflectance = terrain.WaterReflectance
					originalLighting.WaterTransparency = terrain.WaterTransparency
				end
				terrain.WaterReflectance = 0
				terrain.WaterTransparency = 1
			end)
			pcall(function()
				for _, v in pairs(lighting_svc:GetChildren()) do
					if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") then
						saveProp(v, "Parent")
						v.Parent = nil
					end
				end
			end)
		end

		local descendants = workspace_svc:GetDescendants()
		for i, v in ipairs(descendants) do
			if boostToken ~= myToken then return end
			pcall(function()
				optimizeInstance(v, level, mult)
			end)
			if i % 5000 == 0 then
				task.wait()
			end
		end

		if boostToken ~= myToken then return end
		if ultraConnection then ultraConnection:Disconnect() end
		ultraConnection = workspace_svc.DescendantAdded:Connect(function(v)
			if not boostOn then return end
			pcall(function()
				local activeMult = afkEnabled and (afkMultipliers[afkLevel] or 3) or 1
				optimizeInstance(v, level, activeMult)
			end)
		end)
	else
		restoreOriginalState(myToken)
	end
end

