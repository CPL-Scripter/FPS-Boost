local function getClampedPos(targetSizeY)
	local screenSize = gui.AbsoluteSize
	if screenSize.X == 0 or screenSize.Y == 0 then
		screenSize = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(800, 600)
	end
	local halfX = 180 / 2
	local halfY = targetSizeY / 2
	local curX = frame.Position.X.Offset
	local curY = frame.Position.Y.Offset
	return UDim2.new(0, math.clamp(curX, halfX, math.max(halfX, screenSize.X - halfX)), 0, math.clamp(curY, halfY, math.max(halfY, screenSize.Y - halfY)))
end

local function switchTab(targetTab)
	if isTransitioning or confirmMenu.Visible then return end

	local nextTab = (currentTab == targetTab) and "Main" or targetTab

	if isMinimized then
		isMinimized = false
		minimizeButton.Text = "-"
		local targetPos = getClampedPos(95)
		if animEnabled then
			TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 180, 0, 95), Position = targetPos}):Play()
		else
			frame.Size = UDim2.new(0, 180, 0, 95)
			frame.Position = targetPos
		end

		currentTab = nextTab
		for name, d in pairs(tabData) do
			d.frame.Visible = (name == currentTab)
			d.frame.Position = UDim2.new(0, 0, 0, d.baseY)
			if d.frame:IsA("ScrollingFrame") then
				d.frame.CanvasPosition = Vector2.new(0, 0)
				d.frame.ScrollBarImageTransparency = (name == currentTab) and 0 or 1
			end
		end

		updateTopButtons()
		task.spawn(function() animateTitle(tabData[currentTab].title) end)
		fadeGroup(tabData[currentTab].group, false, 0.22)
		return
	end

	isTransitioning = true
	local prevTab = currentTab
	currentTab = nextTab

	local outData = tabData[prevTab]
	local inData = tabData[currentTab]
	local dir = (inData.order > outData.order) and 1 or -1

	updateTopButtons()
	task.spawn(function() animateTitle(inData.title) end)

	if inData.frame:IsA("ScrollingFrame") then
		inData.frame.CanvasPosition = Vector2.new(0, 0)
	end

	if not animEnabled then
		fadeGroup(outData.group, true, 0)
		outData.frame.Visible = false
		outData.frame.Position = UDim2.new(0, 0, 0, outData.baseY)
		if outData.frame:IsA("ScrollingFrame") then
			outData.frame.ScrollBarImageTransparency = 1
		end
		inData.frame.Position = UDim2.new(0, 0, 0, inData.baseY)
		inData.frame.Visible = true
		if inData.frame:IsA("ScrollingFrame") then
			inData.frame.ScrollBarImageTransparency = 0
		end
		fadeGroup(inData.group, false, 0)
		isTransitioning = false
		return
	end

	inData.frame.Visible = true
	fadeGroup(outData.group, true, 0.2)
	slideFrame(outData.frame, true, 0.2, dir)

	task.spawn(function()
		task.wait(0.1)
		fadeGroup(inData.group, false, 0.2)
		slideFrame(inData.frame, false, 0.2, dir)
		task.wait(0.2)
		outData.frame.Visible = false
		outData.frame.Position = UDim2.new(0, 0, 0, outData.baseY)
		isTransitioning = false
	end)
end

