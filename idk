local isRotating = false
local spinConn = nil
local function playSpinAnimation(targetRot)
	if not animEnabled then
		settingsButton.Rotation = targetRot % 360
		return
	end
	if isRotating then return end
	isRotating = true
	local startRotation = settingsButton.Rotation
	local duration = 0.3
	local elapsed = 0
	if spinConn then spinConn:Disconnect() end
	spinConn = RunService.RenderStepped:Connect(function(dt)
		elapsed = elapsed + dt
		local alpha = math.clamp(elapsed / duration, 0, 1)
		local easedAlpha = 1 - math.pow(1 - alpha, 3)
		settingsButton.Rotation = startRotation + ((targetRot - startRotation) * easedAlpha)
		if alpha >= 1 then
			settingsButton.Rotation = targetRot % 360
			isRotating = false
			spinConn:Disconnect()
			spinConn = nil
		end
	end)
	table.insert(connections, spinConn)
end

