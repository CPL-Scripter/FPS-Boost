				end
			end
		]], CONFIG_FILE, CONFIG_FILE, SCRIPT_FILE, SCRIPT_FILE, SCRIPT_URL, SCRIPT_URL)
		pcall(function()
			queueteleport(payload)
		end)
	end
end

