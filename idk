local function animateTitle(newText)
	if title.Text == newText then return end
	local targetPos = (currentTab == "Main") and titleOriginalPos or UDim2.new(0, 22, 0, 2)
	if not animEnabled then
		title.Text = newText
		title.Position = targetPos
		title.TextTransparency = 0
		return
	end
	if isTitleAnimating then return end
	isTitleAnimating = true
	local fadeOutInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local fadeInInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(title, fadeOutInfo, {TextTransparency = 1, Position = UDim2.new(0, targetPos.X.Offset - 4, 0, 2)}):Play()
	task.wait(0.15)
	title.Text = newText
	title.Position = UDim2.new(0, targetPos.X.Offset + 10, 0, 2)
	TweenService:Create(title, fadeInInfo, {TextTransparency = 0, Position = targetPos}):Play()
	task.wait(0.2)
	isTitleAnimating = false
end

local dragging = false
local isDraggingSlider = false
local isDraggingFpsCap = false
local dragStart, startPosOffset

table.insert(connections, frame.InputBegan:Connect(function(input)
	if isDraggingSlider or isDraggingFpsCap then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosOffset = Vector2.new(frame.Position.X.Offset, frame.Position.Y.Offset)
		local dragEnd
		dragEnd = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				dragEnd:Disconnect()
			end
		end)
	end
end))

table.insert(connections, UIS.InputChanged:Connect(function(input)
	if dragging and not isDraggingSlider and not isDraggingFpsCap and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local screenSize = gui.AbsoluteSize
		if screenSize.X == 0 or screenSize.Y == 0 then
			screenSize = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(800, 600)
		end
		local halfX = frame.Size.X.Offset / 2
		local halfY = frame.Size.Y.Offset / 2
		local centerX = math.clamp(startPosOffset.X + delta.X, halfX, math.max(halfX, screenSize.X - halfX))
		local centerY = math.clamp(startPosOffset.Y + delta.Y, halfY, math.max(halfY, screenSize.Y - halfY))
		frame.Position = UDim2.new(0, centerX, 0, centerY)
	end
end))

