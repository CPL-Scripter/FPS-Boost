local function saveConfig()
	env.FPSBoost_SavedConfig = config
	if writefile then
		pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode(config))
		end)
	end
end

local function loadConfig()
	if env.FPSBoost_SavedConfig and type(env.FPSBoost_SavedConfig) == "table" then
		for k, v in pairs(env.FPSBoost_SavedConfig) do
			config[k] = v
		end
	end
	if readfile and isfile then
		pcall(function()
			if isfile(CONFIG_FILE) then
				local decoded = HttpService:JSONDecode(readfile(CONFIG_FILE))
				if type(decoded) == "table" then
					if decoded.Mode == "Low" or decoded.Mode == "Medium" or decoded.Mode == "High" or decoded.Mode == "Ultra" then
						config.Mode = decoded.Mode
					end
					if type(decoded.Anim) == "boolean" then config.Anim = decoded.Anim end
					if type(decoded.Afk) == "boolean" then config.Afk = decoded.Afk end
					if type(decoded.AfkLevel) == "number" then config.AfkLevel = math.clamp(decoded.AfkLevel, 1, 3) end
					if type(decoded.AutoOn) == "boolean" then config.AutoOn = decoded.AutoOn end
					if type(decoded.AutoExec) == "boolean" then config.AutoExec = decoded.AutoExec end
					if type(decoded.FpsCap) == "boolean" then config.FpsCap = decoded.FpsCap end
					if type(decoded.SmartFpsCap) == "boolean" then config.SmartFpsCap = decoded.SmartFpsCap end
					if type(decoded.FpsCapValue) == "number" then config.FpsCapValue = math.clamp(math.round(decoded.FpsCapValue), 15, 240) end
					if type(decoded.Language) == "string" and Languages[decoded.Language] then config.Language = decoded.Language end
				end
			end
		end)
	end
	if config.FpsCap and config.SmartFpsCap then
		config.SmartFpsCap = false
	end
end
