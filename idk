			local HttpService = game:GetService("HttpService")
			local allowRun = true
			if isfile and readfile and isfile(%q) then
				local ok, data = pcall(function() return HttpService:JSONDecode(readfile(%q)) end)
				if ok and type(data) == "table" and data.AutoExec == false then
					allowRun = false
				end
			end
			if allowRun then
				if isfile and readfile and isfile(%q) then
					loadstring(readfile(%q))()
