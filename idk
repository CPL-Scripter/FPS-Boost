local origProps = {}

local function collectAll(elements)
	local list = {}
	for _, el in ipairs(elements) do
		if el then
			table.insert(list, el)
			for _, d in ipairs(el:GetDescendants()) do
				table.insert(list, d)
			end
		end
	end
	return list
end

local function cacheOrig(elements)
	for _, obj in ipairs(collectAll(elements)) do
		if not origProps[obj] then
			local data = {}
			if obj:IsA("TextLabel") or obj:IsA("TextButton") then data.Text = obj.TextTransparency end
			if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then data.Image = obj.ImageTransparency end
			if obj:IsA("GuiObject") then data.Bg = obj.BackgroundTransparency end
			local stroke = obj:FindFirstChildOfClass("UIStroke")
			if stroke then
				data.Stroke = stroke.Transparency
				data.StrokeObj = stroke
			end
			origProps[obj] = data
		end
	end
end

local function fadeGroup(elements, fadeOut, duration)
	local d = animEnabled and duration or 0
	for _, obj in ipairs(collectAll(elements)) do
		local props = origProps[obj]
		if props then
			if d == 0 then
				if props.Text then obj.TextTransparency = fadeOut and 1 or props.Text end
				if props.Image then obj.ImageTransparency = fadeOut and 1 or props.Image end
				if props.Bg then obj.BackgroundTransparency = fadeOut and 1 or props.Bg end
				if props.StrokeObj then props.StrokeObj.Transparency = fadeOut and 1 or props.Stroke end
			else
				local tw = {}
				if props.Text then tw.TextTransparency = fadeOut and 1 or props.Text end
				if props.Image then tw.ImageTransparency = fadeOut and 1 or props.Image end
				if props.Bg then tw.BackgroundTransparency = fadeOut and 1 or props.Bg end
				if next(tw) then
					TweenService:Create(obj, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), tw):Play()
				end
				if props.StrokeObj then
					TweenService:Create(props.StrokeObj, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = fadeOut and 1 or props.Stroke}):Play()
				end
			end
		end
	end
end

local function setGroupHidden(elements)
	for _, obj in ipairs(collectAll(elements)) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then obj.TextTransparency = 1 end
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then obj.ImageTransparency = 1 end
		if obj:IsA("GuiObject") then obj.BackgroundTransparency = 1 end
		local stroke = obj:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Transparency = 1 end
	end
end

local function slideFrame(fr, fadeOut, duration, direction)
	local targetY = fr:IsA("ScrollingFrame") and SCROLL_Y or BASE_Y
	local d = animEnabled and duration or 0
	if fr:IsA("ScrollingFrame") then
		if d == 0 then
			fr.ScrollBarImageTransparency = fadeOut and 1 or 0
		else
			TweenService:Create(fr, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				ScrollBarImageTransparency = fadeOut and 1 or 0
			}):Play()
		end
	end
	if d == 0 then
		fr.Position = UDim2.new(0, 0, 0, targetY)
		return
	end
	if fadeOut then
		TweenService:Create(fr, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(direction * -0.3, 0, 0, targetY)
		}):Play()
	else
		fr.Position = UDim2.new(direction * 0.3, 0, 0, targetY)
		TweenService:Create(fr, TweenInfo.new(d, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 0, 0, targetY)
		}):Play()
	end
end

